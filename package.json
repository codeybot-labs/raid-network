{
  "name": "raid-network",
  "version": "0.1.0",
  "private": true,
  "description": "Raid Network: find raid partners, map your raid network, and duel other streamers' chats. Cloudflare Workers + Astro + SolidJS.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev --var DEMO_MODE:true --var EVENTSUB_SECRET:demo-eventsub-secret --test-scheduled",
    "dev:live": "bash scripts/dev-live.sh",
    "dev:web": "astro dev",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && astro check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "live:check": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "^7.4.4",
    "hono": "^4.13.14",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  }
}
