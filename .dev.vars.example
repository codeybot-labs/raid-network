# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars).
# In production set these with `npx wrangler secret put NAME`.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
# Random string 10-100 chars; Twitch signs EventSub webhooks with it.
EVENTSUB_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# Optional: Twitch user id of a bot account that reads/sends chat. Defaults to the broadcaster.
BOT_USER_ID=
