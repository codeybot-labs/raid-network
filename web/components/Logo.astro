---
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="#1a1130" stroke="rgba(183,156,255,.35)" />
  <path d="M9 22 L16 9 L23 20" stroke="#8b5cf6" stroke-width="2.4" fill="none" stroke-linecap="round" />
  <path d="M9 22 L23 20" stroke="#b79cff" stroke-width="1.6" stroke-dasharray="2 2.4" stroke-linecap="round" />
  <circle cx="9" cy="22" r="3.4" fill="#44e1ff" />
  <circle cx="16" cy="9" r="3.4" fill="#c8ff4d" />
  <circle cx="23" cy="20" r="3.4" fill="#ff4fa3" />
</svg>
